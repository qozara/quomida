{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@quomida/domain-core": ["packages/domain-core/src/index.ts"],
      "@quomida/cloud-providers": ["packages/cloud-providers/src/index.ts"],
      "@quomida/llm-engine": ["packages/llm-engine/src/index.ts"],
      "@quomida/i18n-locales": ["packages/i18n-locales/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist", "build"]
}
