{
  "name": "@quomida/etl-pipeline",
  "version": "1.0.0",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "build": "tsc --noEmit",
    "build:system": "tsx src/build-system.ts",
    "build:external": "tsx src/build-external.ts",
    "generate-system-catalog": "tsx src/scripts/generate-system-catalog.ts",
    "clean": "tsx src/scripts/clean.ts",
    "clean:all": "tsx src/scripts/clean.ts --all",
    "show-catalog-setup": "tsx src/scripts/show-catalog-setup.ts",
    "upload:r2": "tsx src/scripts/upload-r2.ts",
    "upload:r2:preview": "tsx src/scripts/upload-r2.ts --preview",
    "upload:r2:prod": "tsx src/scripts/upload-r2.ts --prod",
    "start": "npx tsx src/build-external.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1145.0",
    "@aws-sdk/lib-storage": "^3.1145.0",
    "@quomida/domain-core": "*",
    "better-sqlite3": "^13.0.3",
    "csv-parse": "^7.0.2",
    "ndjson": "^2.0.0",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/ndjson": "^2.0.4",
    "typescript": "^5.6.3"
  }
}
