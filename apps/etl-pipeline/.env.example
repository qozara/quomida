# Option 1: Using local sample CSV datasets (Requires CSV parsing)
# SYSTEM_INGREDIENTS_URL="file://./data/examples/system_ingredients.csv"
# SYSTEM_PORTIONS_URL="file://./data/examples/system_portions.csv"

# Option 2: Fast-path using a finalized system catalog NDJSON (Skips CSV parsing)
# PREBUILT_SYSTEM_CATALOG_URL="https://example.com/catalog_system.ndjson"

# External sources
# TBCA_URL="https://example.com/actual_tbca.csv"
# SARA2_URL="https://example.com/actual_sara2.csv"
# USDA_URL="https://example.com/actual_usda.csv"

# Cloudflare R2 Upload Credentials (Optional for local `npm run upload:r2:[preview|prod]`)
# For files > 300MB, we use S3 multipart upload which requires S3-compatible R2 credentials.
# Generate in: Cloudflare Dashboard -> R2 -> Manage R2 API Tokens (Object Read & Write permissions).
CLOUDFLARE_ACCOUNT_ID="your_cloudflare_account_id"

# Preview Target (used by: npm run upload:r2:preview)
PREVIEW_CLOUDFLARE_BUCKET_NAME="preview-quomida-data"
PREVIEW_R2_ACCESS_KEY_ID="your_preview_r2_access_key_id"
PREVIEW_R2_SECRET_ACCESS_KEY="your_preview_r2_secret_access_key"

# Production Target (used by: npm run upload:r2:prod)
PROD_CLOUDFLARE_BUCKET_NAME="quomida-data"
PROD_R2_ACCESS_KEY_ID="your_prod_r2_access_key_id"
PROD_R2_SECRET_ACCESS_KEY="your_prod_r2_secret_access_key"

