{
  "name": "quomida",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "license": "MIT",
  "scripts": {
    "dev": "npm run dev --workspace=@quomida/webapp",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:web:e2e": "npm run test:e2e --workspace=@quomida/webapp",
    "test:all:non-interactive": "vitest run && npm run test:web:e2e",
    "cli": "npm run start --workspace=@quomida/cli",
    "etl": "npm run build --workspace=@quomida/etl-pipeline && npx tsx apps/etl-pipeline/src/index.ts"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "ws": "8.21.3",
    "ajv": "8.20.0",
    "esbuild": "0.25.0",
    "vite": "6.4.3",
    "@vitest/mocker": "5.0.0",
    "@quomida/domain-core": {
      "ws": "8.21.3",
      "ajv": "8.20.0"
    },
    "@quomida/webapp": {
      "ws": "8.21.3",
      "ajv": "8.20.0"
    }
  }
}
